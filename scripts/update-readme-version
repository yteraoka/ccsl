#!/bin/sh
# Rewrites the version in README.md's mise install line to the release that
# tagpr is preparing, so the documented command always installs the latest
# release. Run from the repository root by tagpr.command; see .tagpr.
set -eu

: "${TAGPR_NEXT_VERSION:?TAGPR_NEXT_VERSION is not set}"

# mise takes the version without the leading v.
version=${TAGPR_NEXT_VERSION#v}

readme=README.md
prefix='mise use -g github:yteraoka/ccsl@'

sed -i "s|\(${prefix}\)[0-9][0-9.]*|\1${version}|" "$readme"

# tagpr does not treat a non-zero exit as an error, so say so in the log rather
# than leaving a stale version to be merged unnoticed.
if ! grep -qF "${prefix}${version}" "$readme"; then
	echo "update-readme-version: failed to write ${version} to ${readme}" >&2
	exit 1
fi
